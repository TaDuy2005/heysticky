// Report a bug by email (Figma 08a-08c). Deploy: npx wrangler deploy (from this folder).
// Secrets, set once with npx wrangler secret put <NAME>:
//   OWNER_EMAIL  where reports go; a verified Email Routing destination address
//   GH_APP_ID    the bot GitHub App (Issues: read and write, installed on the heysticky repo only)
//   GH_APP_KEY   that App's private key (.pem); never commit it
// Email Sending is onboarded for sticky.davidtalab.cc. Mail to any address (the confirm link) needs Workers Paid.
{
  "name": "heysticky-bugs",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sticky.davidtalab.cc", "custom_domain": true }],
  "vars": { "FROM": "report@sticky.davidtalab.cc", "REPO": "TaDuy2005/heysticky" },
  "kv_namespaces": [{ "binding": "PENDING", "id": "04d8c97a6a574cbb87acac013640a470" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
